---
// /tv — 1920x1080 broadcast page for the 24/7 YouTube live stream (OBS browser source).
// Auto-rotates scenes, auto-reloads to pick up new deploys. No interaction.
import { readFileSync, existsSync } from "node:fs";
import { fileURLToPath } from "node:url";
import { chartSVG } from "../../../pipeline/src/chart";
import { BASELINE_NAME, MODELS, STARTING_BANKROLL } from "../../../pipeline/src/config";
import { initialState, bankroll, type Bet, type State } from "../../../pipeline/src/state";
import { flagOf } from "../flags";

const statePath = fileURLToPath(new URL("../../../data/state.json", import.meta.url));
const state: State = existsSync(statePath)
  ? JSON.parse(readFileSync(statePath, "utf8"))
  : initialState([...MODELS.map((m) => m.name), BASELINE_NAME], STARTING_BANKROLL, new Date().toISOString());

const COLORS: Record<string, string> = Object.fromEntries([
  ...MODELS.map((m) => [m.name, m.color]),
  [BASELINE_NAME, "#6b7280"],
]);
const LOGOS: Record<string, { src: string; invert?: boolean }> = {
  "Claude": { src: "/logos/claude.svg" },
  "GPT-5.5": { src: "/logos/gpt-5.svg", invert: true },
  "Gemini": { src: "/logos/gemini.svg" },
  "Grok": { src: "/logos/grok.svg", invert: true },
  "DeepSeek": { src: "/logos/deepseek.svg" },
  "Mistral": { src: "/logos/mistral.svg" },
};

const money = (n: number) => `$${Math.round(n).toLocaleString("en-US")}`;
const standings = Object.keys(state.series)
  .sort((a, b) => bankroll(state, b) - bankroll(state, a))
  .map((name) => ({ name, roll: bankroll(state, name), delta: bankroll(state, name) - STARTING_BANKROLL }));
const maxAbsDelta = Math.max(100, ...standings.map((s) => Math.abs(s.delta)));
const leader = standings[0];
const baselineStanding = standings.find((s) => s.name === BASELINE_NAME) ?? standings[standings.length - 1];
const baselineRank = standings.findIndex((s) => s.name === BASELINE_NAME) + 1;
const aiCount = standings.filter((s) => s.name !== BASELINE_NAME).length;
const aisBeatingBaseline = standings.filter((s) => s.name !== BASELINE_NAME && s.roll > baselineStanding.roll).length;
const aiLeader = standings.find((s) => s.name !== BASELINE_NAME) ?? leader;

const pending = state.bets.filter((b) => b.status === "pending")
  .sort((a, b) => a.kickoff.localeCompare(b.kickoff));
const liveMatches = state.meta.liveMatches ?? [];
const liveMatch = liveMatches[0] ?? null;
const liveMatchHasBets = liveMatch
  ? pending.some((b) => b.matchId === liveMatch.matchId || (b.homeTeam === liveMatch.homeTeam && b.awayTeam === liveMatch.awayTeam && b.kickoff === liveMatch.kickoff))
  : false;
const settledAll = state.bets.filter((b) => b.status !== "pending")
  .sort((a, b) => b.kickoff.localeCompare(a.kickoff));
const settled = settledAll.slice(0, 14);

const byMatch = (bets: Bet[]) => {
  const m = new Map<string, Bet[]>();
  for (const b of bets) m.set(b.matchId, [...(m.get(b.matchId) ?? []), b]);
  return [...m.values()];
};
const chunks = <T,>(items: T[], size: number): T[][] =>
  Array.from({ length: Math.ceil(items.length / size) }, (_, i) => items.slice(i * size, i * size + size));
const pendingMatches = byMatch(pending);
const pendingMatchPages = chunks(pendingMatches, 2);

const pickLabel = (b: Bet) =>
  b.pick === "draw" ? "🤝 Draw"
  : b.pick === "home" ? `${flagOf(b.homeTeam)} ${b.homeTeam}`
  : `${flagOf(b.awayTeam)} ${b.awayTeam}`;
const badge = (s: string) => s === "won" ? "✅" : s === "lost" ? "❌" : s === "void" ? "↩︎" : "⏳";
const kickoffShort = (iso: string) =>
  new Date(iso).toLocaleString("en-GB", { weekday: "short", hour: "2-digit", minute: "2-digit", timeZone: "UTC" }) + " UTC";

const matchday = Math.max(1, Math.floor((Date.now() - Date.parse("2026-06-11T00:00:00Z")) / 86_400_000) + 1);
const svg = chartSVG(state, 1700, 760);
const resultMoney = (b: Bet) =>
  b.status === "won" ? b.stake * (b.odds - 1)
  : b.status === "lost" ? -b.stake
  : 0;
const resultLabel = (b: Bet) =>
  b.settledResult === "void" ? "Void"
  : b.settledResult === "draw" ? "Draw"
  : b.settledResult === "home" ? b.homeTeam
  : b.settledResult === "away" ? b.awayTeam
  : "Pending";
const signedMoney = (n: number) => n === 0 ? "±$0" : `${n > 0 ? "+" : "−"}${money(Math.abs(n))}`;
const settledMatchesFull = byMatch(settledAll);
const latestResultBets = settledMatchesFull[0] ?? [];
const latestResult = latestResultBets[0];
const latestWinner = latestResult ? resultLabel(latestResult) : null;
const resultHeadline = latestResult
  ? latestWinner === "Draw"
    ? `${latestResult.homeTeam} vs ${latestResult.awayTeam} ended draw${latestResult.settledScore ? ` (${latestResult.settledScore})` : ""}`
    : `${latestWinner} beat ${latestWinner === latestResult.homeTeam ? latestResult.awayTeam : latestResult.homeTeam}${latestResult.settledScore ? ` ${latestResult.settledScore}` : ""}`
  : null;
const biggestMove = settledAll.length
  ? [...settledAll].sort((a, b) => Math.abs(resultMoney(b)) - Math.abs(resultMoney(a)))[0]
  : null;
const nextMatchBets = pendingMatches[0] ?? [];
const nextMatch = liveMatch ?? nextMatchBets[0] ?? state.meta.upcomingMatches?.[0] ?? null;
const topRisk = pending.length ? [...pending].sort((a, b) => b.stake - a.stake)[0] : null;
const liveMatchBetCount = liveMatch
  ? pending.filter((b) => b.matchId === liveMatch.matchId || (b.homeTeam === liveMatch.homeTeam && b.awayTeam === liveMatch.awayTeam && b.kickoff === liveMatch.kickoff)).length
  : 0;
const story = liveMatch && liveMatchHasBets
  ? `${liveMatch.homeTeam} vs ${liveMatch.awayTeam} is live with ${liveMatchBetCount} AI bets in play.`
  : latestResult
  ? `${resultHeadline}. ${aisBeatingBaseline}/${aiCount} AIs are beating the baseline.`
  : pending.length
    ? `${pending.length} bets are live for the current 24h cycle. ${aisBeatingBaseline}/${aiCount} AIs are beating the baseline.`
    : `The baseline ranks #${baselineRank}. ${aisBeatingBaseline}/${aiCount} AIs are beating a simple favorite rule.`;

// Quotes for the reasoning spotlight: pending first, padded with latest settled.
const quoteBets = [...pending, ...settled].slice(0, 20).map((b) => ({
  model: b.model, color: COLORS[b.model] ?? "#6b7280",
  pick: pickLabel(b), stake: money(b.stake), odds: b.odds,
  match: `${flagOf(b.homeTeam)} ${b.homeTeam} vs ${b.awayTeam} ${flagOf(b.awayTeam)}`,
  status: b.status, reasoning: b.reasoning,
}));
const kickoffs = [...new Set(pending.map((b) => b.kickoff))].sort();
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>LLM World Cup Bets — TV</title>
  <meta name="robots" content="noindex" />
  <style>
    @font-face { font-family: "Space Mono"; src: url("/fonts/SpaceMono-Regular.ttf") format("truetype"); font-weight: 400; }
    @font-face { font-family: "Space Mono"; src: url("/fonts/SpaceMono-Bold.ttf") format("truetype"); font-weight: 700; }
    :root {
      --bg: #050607; --panel: #0d0f12; --panel-2: #12151a; --line: #1c2128;
      --txt: #e7e9ea; --dim: #8b949e; --faint: #555e6a;
      --amber: #f59e0b; --up: #22c55e; --down: #ef4444;
    }
    * { box-sizing: border-box; margin: 0; }
    html, body { width: 1920px; height: 1080px; overflow: hidden; background: var(--bg);
      color: var(--txt); font-family: "Space Mono", ui-monospace, monospace;
      font-variant-numeric: tabular-nums; }
    body::after { content: ""; position: fixed; inset: 0; pointer-events: none; z-index: 50;
      background: repeating-linear-gradient(0deg, transparent 0 3px, rgba(255,255,255,.012) 3px 4px); }

    /* ── top bar ── */
    .topbar { height: 96px; display: flex; align-items: center; gap: 40px; padding: 0 48px;
      border-bottom: 1px solid var(--line); font-size: 24px; text-transform: uppercase; letter-spacing: .08em; }
    .live { color: var(--up); font-weight: 700; display: inline-flex; align-items: center; gap: 14px; }
    .live::before { content: ""; width: 16px; height: 16px; border-radius: 50%; background: var(--up);
      animation: pulse 1.6s ease-in-out infinite; }
    @keyframes pulse { 50% { opacity: .15; } }
    .topbar .dim { color: var(--dim); }
    .topbar .lead b { color: var(--amber); }
    .topbar .spacer { flex: 1; }
    .countdown { color: var(--txt); }
    .countdown b { color: var(--amber); }
    .clock { color: var(--faint); }
    .brand { font-weight: 700; font-size: 26px; letter-spacing: .04em; }
    .brand .accent { color: var(--amber); }

    /* ── stage / scenes ── */
    .stage { position: relative; height: calc(1080px - 96px - 84px); }
    .scene { position: absolute; inset: 0; padding: 48px 64px; opacity: 0;
      transition: opacity .8s ease; pointer-events: none; }
    .scene.on { opacity: 1; }
    .scene h2 { font-size: 30px; text-transform: uppercase; letter-spacing: .14em;
      display: flex; align-items: center; gap: 18px; margin-bottom: 34px; }
    .scene h2::before { content: ""; width: 10px; height: 30px; background: var(--amber); }
    .scene h2::after { content: ""; flex: 1; height: 1px; background: var(--line); }
    .scene h2 .count { color: var(--faint); letter-spacing: 0; }

    /* story screen */
    .hero { height: 100%; display: grid; grid-template-columns: 1.15fr .85fr; gap: 44px; align-items: stretch; }
    .hero-main { border: 1px solid color-mix(in srgb, var(--amber) 45%, var(--line)); border-radius: 18px;
      background: radial-gradient(circle at 20% 0%, rgba(245,158,11,.18), transparent 34%), var(--panel);
      padding: 58px; display: flex; flex-direction: column; justify-content: space-between; }
    .eyebrow { color: var(--amber); font-size: 28px; text-transform: uppercase; letter-spacing: .16em; }
    .story { font-size: 78px; line-height: 1.06; font-weight: 700; letter-spacing: -.05em; max-width: 1040px; }
    .hero-meta { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
    .metric { background: rgba(255,255,255,.035); border: 1px solid var(--line); border-radius: 14px; padding: 24px; }
    .metric .label { color: var(--faint); font-size: 18px; text-transform: uppercase; letter-spacing: .12em; }
    .metric .value { margin-top: 12px; font-size: 42px; font-weight: 700; }
    .metric.good .value { color: var(--up); } .metric.bad .value { color: var(--down); } .metric.hot .value { color: var(--amber); }
    .side-stack { display: grid; gap: 26px; }
    .story-card { background: var(--panel); border: 1px solid var(--line); border-radius: 18px; padding: 34px; }
    .story-card h3 { color: var(--dim); font-size: 22px; text-transform: uppercase; letter-spacing: .14em; margin-bottom: 18px; }
    .story-card .big { font-size: 46px; line-height: 1.1; font-weight: 700; }
    .story-card .sub { margin-top: 12px; color: var(--faint); font-size: 24px; }
    .story-card .pl { margin-top: 18px; font-size: 34px; font-weight: 700; }
    .story-card .pl.hot { color: var(--amber); }

    /* last result feature */
    .result-feature { display: grid; grid-template-columns: .9fr 1.1fr; gap: 36px; }
    .score-card { background: var(--panel); border: 1px solid var(--line); border-radius: 18px; padding: 42px; }
    .score-card .teams { font-size: 54px; line-height: 1.15; font-weight: 700; }
    .score-card .winner { margin-top: 34px; color: var(--amber); font-size: 42px; }
    .score-card .score { margin-top: 18px; color: var(--dim); font-size: 34px; }
    .result-list { background: var(--panel); border: 1px solid var(--line); border-radius: 18px; padding: 24px 30px; }
    .result-row { display: grid; grid-template-columns: 52px 210px 1fr 170px 170px; align-items: center; gap: 18px;
      padding: 14px 0; border-top: 1px solid var(--line); font-size: 26px; }
    .result-row:first-child { border-top: 0; }

    /* leaderboard */
    .standings { display: flex; flex-direction: column; gap: 14px; }
    .standing { display: grid; grid-template-columns: 70px 48px 320px 1fr 220px 260px;
      align-items: center; gap: 26px; background: var(--panel); border: 1px solid var(--line);
      border-radius: 10px; padding: 18px 30px; font-size: 30px; }
    .standing.first { border-color: color-mix(in srgb, var(--amber) 45%, var(--line));
      background: linear-gradient(90deg, rgba(245,158,11,.07), var(--panel) 40%); }
    .standing .rank { color: var(--faint); font-size: 24px; }
    .standing.first .rank { color: var(--amber); font-weight: 700; }
    .standing .name { font-weight: 700; }
    .logo { width: 40px; height: 40px; display: block; }
    .logo.invert { filter: invert(1); }
    .dot { width: 22px; height: 22px; border-radius: 50%; background: var(--c); margin: 9px; }
    .pl-track { height: 12px; border-radius: 6px; background: var(--panel-2); position: relative; overflow: hidden; }
    .pl-bar { position: absolute; top: 0; bottom: 0; border-radius: 6px; }
    .standing .delta { font-size: 26px; text-align: right; }
    .standing .roll { font-weight: 700; font-size: 34px; text-align: right; }
    .up { color: var(--up); } .down { color: var(--down); } .flat { color: var(--faint); }
    .baseline-note { color: var(--faint); font-size: 22px; margin-top: 22px; }
    .baseline-note b { color: var(--dim); }

    /* bets grid */
    .matches { display: grid; grid-template-columns: repeat(2, 1fr); gap: 30px; }
    .matches.single { grid-template-columns: minmax(0, 1100px); justify-content: center; }
    .match { background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 24px 28px; }
    .match h3 { font-size: 30px; margin-bottom: 6px; }
    .match .ko { color: var(--faint); font-size: 21px; margin-bottom: 18px; }
    .bet { display: grid; grid-template-columns: 44px 200px 1fr 170px 110px; align-items: center;
      gap: 16px; padding: 9px 0; border-top: 1px solid var(--line); font-size: 25px; }
    .bet .model { font-weight: 700; }
    .bet .pick { color: var(--dim); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .bet .stake { text-align: right; font-weight: 700; }
    .bet .odds { color: var(--faint); }
    .bet .result { text-align: right; }

    /* reasoning spotlight */
    #scene-quote .inner { max-width: 1500px; margin: 30px auto 0; }
    .q-head { display: flex; align-items: center; gap: 24px; font-size: 30px; margin-bottom: 30px; }
    .q-head .q-model { font-weight: 700; font-size: 38px; }
    .q-head .q-bet { color: var(--dim); }
    .q-text { font-size: 38px; line-height: 1.55; color: var(--txt); }
    .q-text::before { content: "“"; color: var(--amber); }
    .q-text::after { content: "”"; color: var(--amber); }
    .q-match { margin-top: 34px; color: var(--faint); font-size: 26px; }

    /* chart */
    .chart svg { display: block; width: 1700px; height: auto; border: 1px solid var(--line); border-radius: 10px; }

    /* ── bottom lower third ── */
    .bottombar { height: 84px; border-top: 1px solid var(--line); display: grid; grid-template-columns: auto 1fr auto;
      align-items: center; overflow: hidden; position: relative; background: #07080a; }
    .lower-live { align-self: stretch; display: flex; align-items: center; gap: 12px; padding: 0 34px;
      background: var(--up); color: #041007; font-size: 26px; font-weight: 700; text-transform: uppercase; letter-spacing: .1em; }
    .lower-main { white-space: nowrap; overflow: hidden; font-size: 24px; color: var(--txt); }
    .lower-main b { color: var(--amber); }
    .lower-scroll { display: inline-block; padding-left: 100%; animation: scroll 42s linear infinite; }
    @keyframes scroll { to { transform: translateX(-100%); } }
    .url-badge { align-self: stretch; display: flex; align-items: center;
      background: var(--bg); border-left: 1px solid var(--line); padding: 0 40px;
      font-weight: 700; font-size: 28px; color: var(--amber); z-index: 2; }
  </style>
</head>
<body>
  <div class="topbar">
    <span class="live">Live</span>
    <span class="dim">Matchday {matchday}/39</span>
    <span class="lead dim">Leader: <b>{leader.name} {money(leader.roll)}</b></span>
    <span class="spacer"></span>
    <span class="countdown" id="countdown"></span>
    <span class="clock" id="clock"></span>
    <span class="brand">LLM WORLD CUP <span class="accent">BETS</span></span>
  </div>

  <div class="stage">
    <section class="scene on" id="scene-story">
      <div class="hero">
        <div class="hero-main">
          <p class="eyebrow">Main story</p>
          <p class="story">{story}</p>
          <div class="hero-meta">
            <div class={`metric ${aisBeatingBaseline >= Math.ceil(aiCount / 2) ? "good" : "bad"}`}>
              <p class="label">AIs beating baseline</p>
              <p class="value">{aisBeatingBaseline}/{aiCount}</p>
            </div>
            <div class="metric hot">
              <p class="label">Baseline rank</p>
              <p class="value">#{baselineRank}</p>
            </div>
            <div class="metric">
              <p class="label">Leader</p>
              <p class="value">{leader.name}</p>
            </div>
          </div>
        </div>
        <div class="side-stack">
          <div class="story-card">
            <h3>Top AI</h3>
            <p class="big">{aiLeader.name}</p>
            <p class={`pl ${aiLeader.delta >= 0 ? "up" : "down"}`}>{signedMoney(aiLeader.delta)}</p>
            <p class="sub">{money(aiLeader.roll)} bankroll</p>
          </div>
          <div class="story-card">
            <h3>Next match</h3>
            {nextMatch ? (
              <>
                <p class="big">{flagOf(nextMatch.homeTeam)} {nextMatch.homeTeam}<br />vs {nextMatch.awayTeam} {flagOf(nextMatch.awayTeam)}</p>
                <p class="sub">{kickoffShort(nextMatch.kickoff)}</p>
              </>
            ) : <p class="big">Waiting for schedule</p>}
          </div>
          <div class="story-card">
            <h3>Biggest risk now</h3>
            {topRisk ? (
              <>
                <p class="big">{topRisk.model}</p>
                <p class="pl hot">Stake {money(topRisk.stake)}</p>
                <p class="sub">on {pickLabel(topRisk)} @ {topRisk.odds}</p>
              </>
            ) : biggestMove ? (
              <>
                <p class="big">{biggestMove.model} · {signedMoney(resultMoney(biggestMove))}</p>
                <p class="sub">{biggestMove.homeTeam} vs {biggestMove.awayTeam}</p>
              </>
            ) : <p class="big">No bets yet</p>}
          </div>
        </div>
      </div>
    </section>

    <section class="scene" id="scene-board">
      <h2>Leaderboard <span class="count">· 6 AIs + 1 baseline · $10,000 each</span></h2>
      <div class="standings">
        {standings.map((s, i) => (
          <div class={`standing${i === 0 ? " first" : ""}`}>
            <span class="rank">{String(i + 1).padStart(2, "0")}</span>
            {LOGOS[s.name]
              ? <img class={`logo${LOGOS[s.name].invert ? " invert" : ""}`} src={LOGOS[s.name].src} alt="" />
              : <span class="dot" style={`--c:${COLORS[s.name]}`}></span>}
            <span class="name">{s.name}</span>
            <div class="pl-track">
              <div class="pl-bar" style={`background:${s.delta >= 0 ? "var(--up)" : "var(--down)"};
                left:${s.delta >= 0 ? 50 : 50 - (Math.abs(s.delta) / maxAbsDelta) * 50}%;
                width:${(Math.abs(s.delta) / maxAbsDelta) * 50}%`}></div>
            </div>
            <span class={`delta ${s.delta > 0 ? "up" : s.delta < 0 ? "down" : "flat"}`}>
              {s.delta === 0 ? "±$0" : `${s.delta > 0 ? "+" : "−"}${money(Math.abs(s.delta)).slice(0)}`}
            </span>
            <span class="roll">{money(s.roll)}</span>
          </div>
        ))}
      </div>
      <p class="baseline-note">— <b>Baseline</b> bets 10% on the favorite every match, as a simple benchmark.</p>
    </section>

    {pendingMatchPages.map((matchPage, pageIndex) => (
      <section class="scene" id={`scene-bets-${pageIndex + 1}`}>
        <h2>
          Current 24h cycle
          <span class="count">· {pending.length} live bets · page {pageIndex + 1}/{pendingMatchPages.length}</span>
        </h2>
        <div class={`matches${matchPage.length === 1 ? " single" : ""}`}>
          {matchPage.map((bets) => (
            <div class="match">
              <h3>{flagOf(bets[0].homeTeam)} {bets[0].homeTeam} vs {bets[0].awayTeam} {flagOf(bets[0].awayTeam)}</h3>
              <p class="ko">kicks off {kickoffShort(bets[0].kickoff)}</p>
              {bets.map((b) => (
                <div class="bet">
                  <span>⏳</span>
                  <span class="model" style={`color:${COLORS[b.model]}`}>{b.model}</span>
                  <span class="pick">{pickLabel(b)}</span>
                  <span class="stake">{money(b.stake)}</span>
                  <span class="odds">@ {b.odds}</span>
                </div>
              ))}
            </div>
          ))}
        </div>
      </section>
    ))}

    {quoteBets.length > 0 && (
      <section class="scene" id="scene-quote">
        <h2>Why they bet <span class="count">· verbatim reasoning</span></h2>
        <div class="inner">
          <div class="q-head">
            <span class="q-model" id="q-model"></span>
            <span class="q-bet" id="q-bet"></span>
          </div>
          <p class="q-text" id="q-text"></p>
          <p class="q-match" id="q-match"></p>
        </div>
      </section>
    )}

    {latestResult && (
      <section class="scene" id="scene-results">
        <h2>Last result <span class="count">· winner, losers, bankroll impact</span></h2>
        <div class="result-feature">
          <div class="score-card">
            <p class="teams">{flagOf(latestResult.homeTeam)} {latestResult.homeTeam}<br />vs {latestResult.awayTeam} {flagOf(latestResult.awayTeam)}</p>
            <p class="winner">Winner: {latestWinner}</p>
            {latestResult.settledScore && <p class="score">Final score: {latestResult.settledScore}</p>}
            <p class="score">{kickoffShort(latestResult.kickoff)}</p>
          </div>
          <div class="result-list">
            {latestResultBets.map((b) => (
              <div class="result-row">
                <span>{badge(b.status)}</span>
                <span class="model" style={`color:${COLORS[b.model]}`}>{b.model}</span>
                <span class="pick">{pickLabel(b)}</span>
                <span class="stake">{money(b.stake)}</span>
                <span class={`delta ${resultMoney(b) > 0 ? "up" : resultMoney(b) < 0 ? "down" : "flat"}`}>{signedMoney(resultMoney(b))}</span>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="scene" id="scene-chart">
      <h2>Bankroll over time</h2>
      <div class="chart" set:html={svg}></div>
    </section>
  </div>

  <div class="bottombar">
    <div class="lower-live">Live</div>
    <div class="lower-main">
      <div class="lower-scroll">
        {liveMatch && liveMatchHasBets ? `Now live ${liveMatch.homeTeam} vs ${liveMatch.awayTeam} · ` : ""}Leader <b>{leader.name} {money(leader.roll)}</b> · Baseline <b>#{baselineRank} {money(baselineStanding.roll)}</b> · AIs over baseline <b>{aisBeatingBaseline}/{aiCount}</b>{nextMatch && !liveMatch ? ` · Next ${nextMatch.homeTeam} vs ${nextMatch.awayTeam} ${kickoffShort(nextMatch.kickoff)}` : ""} · Every bet + reasoning on <b>llmworldcup.xyz</b> ·
      </div>
    </div>
    <div class="url-badge">llmworldcup.xyz</div>
  </div>

  <script is:inline define:vars={{ quoteBets, kickoffs }}>
    // Scene rotation
    const scenes = [...document.querySelectorAll(".scene")];
    const SCENE_MS = 22_000;
    let si = 0;
    setInterval(() => {
      scenes[si].classList.remove("on");
      si = (si + 1) % scenes.length;
      scenes[si].classList.add("on");
    }, SCENE_MS);

    // Reasoning spotlight rotation
    if (quoteBets.length) {
      let qi = -1;
      const rot = () => {
        qi = (qi + 1) % quoteBets.length;
        const q = quoteBets[qi];
        const el = (id) => document.getElementById(id);
        el("q-model").textContent = q.model;
        el("q-model").style.color = q.color;
        el("q-bet").textContent = `${q.stake} on ${q.pick} @ ${q.odds}`;
        const MAXQ = 420;
        el("q-text").textContent = q.reasoning.length > MAXQ ? q.reasoning.slice(0, MAXQ).trimEnd() + "…" : q.reasoning;
        el("q-match").textContent = q.match;
      };
      rot();
      setInterval(rot, 11_000);
    }

    // Clock + countdown to next kickoff
    const pad = (n) => String(n).padStart(2, "0");
    const tick = () => {
      const now = new Date();
      document.getElementById("clock").textContent =
        `${pad(now.getUTCHours())}:${pad(now.getUTCMinutes())}:${pad(now.getUTCSeconds())} UTC`;
      const next = kickoffs.map((k) => new Date(k)).find((k) => k > now);
      const cd = document.getElementById("countdown");
      if (next) {
        const s = Math.floor((next - now) / 1000);
        cd.innerHTML = `Next kickoff in <b>${Math.floor(s / 3600)}h ${pad(Math.floor(s / 60) % 60)}m ${pad(s % 60)}s</b>`;
      } else { cd.textContent = ""; }
    };
    tick();
    setInterval(tick, 1000);

    // Pick up fresh data: reload between scene changes, every ~6 minutes.
    setTimeout(() => location.reload(), 6 * 60_000 - 3_000);
  </script>
</body>
</html>
