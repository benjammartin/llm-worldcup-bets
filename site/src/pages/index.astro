      posthog.init(POSTHOG_KEY, {
        api_host: POSTHOG_HOST,
        ui_host: "https://us.posthog.com",
        defaults: "2026-05-30",
        person_profiles: "identified_only",
      });
      document.addEventListener("click", function (e) {
        var youtube = e.target.closest && e.target.closest(".youtube-marquee");
        if (youtube) posthog.capture("youtube_live_clicked");
      });
      document.addEventListener("toggle", function (e) {
        var d = e.target;
        if (d.tagName === "DETAILS" && d.open) {
          var model = d.querySelector("summary b");
          posthog.capture("reasoning_opened", { model: model ? model.textContent : "?" });
