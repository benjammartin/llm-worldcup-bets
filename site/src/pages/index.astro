---
import { readFileSync, existsSync } from "node:fs";
import { fileURLToPath } from "node:url";
import { chartSVG } from "../../../pipeline/src/chart";
import { SITE_URL } from "../../../pipeline/src/config";
import { initialState, type Bet, type State } from "../../../pipeline/src/state";

const statePath = fileURLToPath(new URL("../../../data/state.json", import.meta.url));
const state: State = existsSync(statePath)
  ? JSON.parse(readFileSync(statePath, "utf8"))
  : initialState(["Claude", "GPT-5", "Gemini", "Grok", "DeepSeek", "Mistral", "Baseline"], 10_000, new Date().toISOString());
const svg = chartSVG(state, 1200, 630);

const pending = state.bets.filter((b) => b.status === "pending")
  .sort((a, b) => a.kickoff.localeCompare(b.kickoff));
const settled = state.bets.filter((b) => b.status !== "pending")
  .sort((a, b) => b.kickoff.localeCompare(a.kickoff)).slice(0, 60);

const byMatch = (bets: Bet[]) => {
  const m = new Map<string, Bet[]>();
  for (const b of bets) m.set(b.match, [...(m.get(b.match) ?? []), b]);
  return [...m.entries()];
};
const badge = (s: string) => s === "won" ? "✅" : s === "lost" ? "❌" : s === "void" ? "↩︎" : "⏳";
const kickoff = (iso: string) =>
  new Date(iso).toLocaleString("en-GB", { weekday: "short", hour: "2-digit", minute: "2-digit", timeZone: "UTC" }) + " UTC";
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>LLM World Cup Bets — 6 AIs, $10,000 each</title>
  <meta property="og:title" content="LLM World Cup Bets" />
  <meta property="og:description" content="6 AIs, $10,000 each, betting on every match of the World Cup. Who goes broke first?" />
  <meta property="og:image" content={`${SITE_URL}/og.png`} />
  <meta name="twitter:card" content="summary_large_image" />
  <style>
    body { background: #0a0a0a; color: #e5e7eb; font-family: "Space Mono", ui-monospace, monospace; margin: 0 auto; max-width: 1240px; padding: 16px; }
    .chart svg { width: 100%; height: auto; }
    h2 { color: #9ca3af; font-size: 14px; text-transform: uppercase; letter-spacing: 0.1em; margin-top: 40px; }
    details { border-bottom: 1px solid #1f2937; padding: 8px 0; }
    summary { cursor: pointer; display: flex; gap: 12px; flex-wrap: wrap; list-style: none; }
    .model { font-weight: bold; min-width: 90px; }
    .reasoning { color: #9ca3af; padding: 8px 0 4px 0; white-space: pre-wrap; }
    .meta { color: #6b7280; }
    footer { margin: 48px 0 24px; color: #6b7280; font-size: 13px; }
    a { color: #60a5fa; }
  </style>
</head>
<body>
  <div class="chart" set:html={svg} />

  <h2>Pending bets</h2>
  {byMatch(pending).map(([match, bets]) => (
    <section>
      <p class="meta">{match} — kicks off {kickoff(bets[0].kickoff)}</p>
      {bets.map((b) => (
        <details>
          <summary><span class="model">{b.model}</span> {b.pick} · ${b.stake.toLocaleString()} @ {b.odds} {badge(b.status)}</summary>
          <p class="reasoning">{b.reasoning}</p>
        </details>
      ))}
    </section>
  ))}

  <h2>Recent results</h2>
  {byMatch(settled).map(([match, bets]) => (
    <section>
      <p class="meta">{match}</p>
      {bets.map((b) => (
        <details>
          <summary><span class="model">{b.model}</span> {b.pick} · ${b.stake.toLocaleString()} @ {b.odds} {badge(b.status)}</summary>
          <p class="reasoning">{b.reasoning}</p>
        </details>
      ))}
    </section>
  ))}

  <footer>
    Virtual money only — not financial advice. The prompt, the code and every bet's
    history are public: <a href="https://github.com/REPLACE_GH_USER/llm-worldcup-bets">source</a>.
  </footer>
</body>
</html>
