---
import { readFileSync, existsSync } from "node:fs";
import { fileURLToPath } from "node:url";
import { chartSVG } from "../../../pipeline/src/chart";
import { BASELINE_NAME, MODELS, SITE_URL, STARTING_BANKROLL } from "../../../pipeline/src/config";
import { initialState, bankroll, type Bet, type State } from "../../../pipeline/src/state";
import { flagOf } from "../flags";

const statePath = fileURLToPath(new URL("../../../data/state.json", import.meta.url));
const state: State = existsSync(statePath)
  ? JSON.parse(readFileSync(statePath, "utf8"))
  : initialState([...MODELS.map((m) => m.name), BASELINE_NAME], STARTING_BANKROLL, new Date().toISOString());
const svg = chartSVG(state, 1200, 630);

const LOGOS: Record<string, { src: string; invert?: boolean }> = {
  "Claude": { src: "/logos/claude.svg" },
  "GPT-5": { src: "/logos/gpt-5.svg", invert: true },
  "Gemini": { src: "/logos/gemini.svg" },
  "Grok": { src: "/logos/grok.svg", invert: true },
  "DeepSeek": { src: "/logos/deepseek.svg" },
  "Mistral": { src: "/logos/mistral.svg" },
};
const COLORS: Record<string, string> = Object.fromEntries([
  ...MODELS.map((m) => [m.name, m.color]),
  [BASELINE_NAME, "#6b7280"],
]);

const money = (n: number) => `$${Math.round(n).toLocaleString("en-US")}`;
const standings = Object.keys(state.series)
  .sort((a, b) => bankroll(state, b) - bankroll(state, a))
  .map((name) => ({ name, roll: bankroll(state, name), delta: bankroll(state, name) - STARTING_BANKROLL }));

const pending = state.bets.filter((b) => b.status === "pending")
  .sort((a, b) => a.kickoff.localeCompare(b.kickoff));
const settled = state.bets.filter((b) => b.status !== "pending")
  .sort((a, b) => b.kickoff.localeCompare(a.kickoff)).slice(0, 60);

const byMatch = (bets: Bet[]) => {
  const m = new Map<string, Bet[]>();
  for (const b of bets) m.set(b.matchId, [...(m.get(b.matchId) ?? []), b]);
  return [...m.values()];
};
const badge = (s: string) => s === "won" ? "✅" : s === "lost" ? "❌" : s === "void" ? "↩︎" : "⏳";
const pickLabel = (b: Bet) =>
  b.pick === "draw" ? "🤝 Draw"
  : b.pick === "home" ? `${flagOf(b.homeTeam)} ${b.homeTeam}`
  : `${flagOf(b.awayTeam)} ${b.awayTeam}`;
const kickoff = (iso: string) =>
  new Date(iso).toLocaleString("en-GB", { weekday: "short", day: "numeric", month: "short", hour: "2-digit", minute: "2-digit", timeZone: "UTC" }) + " UTC";
const lastUpdate = state.meta.lastSettleRun ?? state.meta.lastBetsRun;
const todayFailures = state.meta.failures.slice(-6);
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>LLM World Cup Bets — 6 AIs, $10,000 each</title>
  <meta name="description" content="6 AIs bet virtual money on every World Cup 2026 match against real bookmaker odds. Live bankrolls, verbatim reasoning, public prompt." />
  <meta property="og:title" content="LLM World Cup Bets" />
  <meta property="og:description" content="6 AIs, $10,000 each, betting on every match of the World Cup. Who goes broke first?" />
  <meta property="og:image" content={`${SITE_URL}/og.png`} />
  <meta name="twitter:card" content="summary_large_image" />
  <style>
    * { box-sizing: border-box; }
    body { background: #0a0a0a; color: #e5e7eb; font-family: "Space Mono", ui-monospace, SFMono-Regular, monospace; margin: 0 auto; max-width: 1240px; padding: 16px 12px 0; }
    header h1 { font-size: clamp(20px, 4.5vw, 32px); letter-spacing: 0.04em; margin: 8px 0 4px; }
    .tagline { color: #9ca3af; font-size: clamp(13px, 2.8vw, 15px); margin: 0 0 4px; line-height: 1.5; max-width: 820px; }
    .tagline b { color: #e5e7eb; }
    .updated { color: #4b5563; font-size: 12px; margin: 0 0 16px; }

    h2 { color: #9ca3af; font-size: 13px; text-transform: uppercase; letter-spacing: 0.12em; margin: 36px 0 10px; }

    .standings { display: flex; flex-direction: column; gap: 6px; }
    .standing { display: grid; grid-template-columns: 24px 24px 1fr auto auto; align-items: center; gap: 10px;
      background: #111318; border: 1px solid #1f2937; border-left: 3px solid var(--c); border-radius: 8px; padding: 8px 12px; }
    .standing .rank { color: #6b7280; font-size: 13px; }
    .standing .name { font-weight: bold; font-size: 14px; }
    .standing .roll { font-weight: bold; font-size: 15px; text-align: right; }
    .standing .delta { font-size: 12px; min-width: 72px; text-align: right; }
    .up { color: #34d399; } .down { color: #f87171; } .flat { color: #6b7280; }
    .logo { width: 20px; height: 20px; display: block; }
    .logo.invert { filter: invert(1); }
    .dot { width: 12px; height: 12px; border-radius: 50%; background: var(--c); margin: 4px; }

    .chart svg { width: 100%; height: auto; border-radius: 8px; }

    .match { background: #111318; border: 1px solid #1f2937; border-radius: 8px; margin-bottom: 12px; overflow: hidden; }
    .match-head { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; flex-wrap: wrap;
      padding: 10px 14px; border-bottom: 1px solid #1f2937; }
    .match-title { font-weight: bold; font-size: 15px; }
    .match-ko { color: #6b7280; font-size: 12px; }
    details { border-top: 1px solid #16181d; }
    details:first-of-type { border-top: none; }
    summary { cursor: pointer; list-style: none; display: grid; grid-template-columns: 24px 92px 1fr auto 28px; align-items: center;
      gap: 8px; padding: 9px 14px; font-size: 13px; }
    summary::-webkit-details-marker { display: none; }
    summary:hover { background: #16181d; }
    .bet-pick { color: #d1d5db; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .bet-stake { color: #9ca3af; text-align: right; white-space: nowrap; }
    .reasoning { color: #9ca3af; font-size: 13px; line-height: 1.55; padding: 4px 14px 12px; margin: 0; white-space: pre-wrap; border-left: 3px solid var(--c); }
    .failures { color: #6b7280; font-size: 13px; }

    footer { margin: 48px 0 24px; color: #6b7280; font-size: 12px; line-height: 1.6; }
    a { color: #60a5fa; }

    @media (max-width: 560px) {
      summary { grid-template-columns: 22px 78px 1fr 26px; }
      .bet-stake { grid-column: 2 / 4; grid-row: 2; text-align: left; font-size: 12px; }
      .standing .delta { min-width: 0; }
    }
  </style>
</head>
<body>
  <header>
    <h1>⚽ LLM WORLD CUP BETS</h1>
    <p class="tagline">6 AIs started the World Cup with <b>$10,000</b> each. Every day they bet on every match against real bookmaker odds — max 25% of their bankroll per bet, reasoning published verbatim. The dashed line just bets the favorite, every time. Highest bankroll on July 19 wins.</p>
    {lastUpdate && <p class="updated">Updates after every match · last update {kickoff(lastUpdate)}</p>}
  </header>

  <section>
    <h2>🏆 Standings</h2>
    <div class="standings">
      {standings.map((s, i) => (
        <div class="standing" style={`--c:${COLORS[s.name] ?? "#fff"}`}>
          <span class="rank">{i + 1}</span>
          {LOGOS[s.name]
            ? <img class={`logo${LOGOS[s.name].invert ? " invert" : ""}`} src={LOGOS[s.name].src} alt={s.name} width="20" height="20" />
            : <span class="dot" title="Always bets the favorite"></span>}
          <span class="name">{s.name}</span>
          <span class={`delta ${s.delta > 0 ? "up" : s.delta < 0 ? "down" : "flat"}`}>
            {s.delta === 0 ? "±$0" : (s.delta > 0 ? "▲ +$" : "▼ −$") + Math.round(Math.abs(s.delta)).toLocaleString("en-US")}
          </span>
          <span class="roll">{money(s.roll)}</span>
        </div>
      ))}
    </div>
  </section>

  <section>
    <h2>📈 Bankroll over time</h2>
    <div class="chart" set:html={svg} />
  </section>

  <section>
    <h2>⏳ Pending bets</h2>
    {byMatch(pending).map((bets) => (
      <div class="match">
        <div class="match-head">
          <span class="match-title">{flagOf(bets[0].homeTeam)} {bets[0].homeTeam} vs {bets[0].awayTeam} {flagOf(bets[0].awayTeam)}</span>
          <span class="match-ko">kicks off {kickoff(bets[0].kickoff)}</span>
        </div>
        {bets.map((b) => (
          <details style={`--c:${COLORS[b.model] ?? "#fff"}`}>
            <summary>
              {LOGOS[b.model]
                ? <img class={`logo${LOGOS[b.model].invert ? " invert" : ""}`} src={LOGOS[b.model].src} alt={b.model} width="20" height="20" />
                : <span class="dot"></span>}
              <b>{b.model}</b>
              <span class="bet-pick">{pickLabel(b)}</span>
              <span class="bet-stake">${b.stake.toLocaleString()} @ {b.odds}</span>
              <span>{badge(b.status)}</span>
            </summary>
            <p class="reasoning">{b.reasoning}</p>
          </details>
        ))}
      </div>
    ))}
    {pending.length === 0 && <p class="failures">No pending bets — next bets land at 09:00 UTC.</p>}
  </section>

  <section>
    <h2>📋 Recent results</h2>
    {byMatch(settled).map((bets) => (
      <div class="match">
        <div class="match-head">
          <span class="match-title">{flagOf(bets[0].homeTeam)} {bets[0].homeTeam} vs {bets[0].awayTeam} {flagOf(bets[0].awayTeam)}</span>
          <span class="match-ko">{kickoff(bets[0].kickoff)}</span>
        </div>
        {bets.map((b) => (
          <details style={`--c:${COLORS[b.model] ?? "#fff"}`}>
            <summary>
              {LOGOS[b.model]
                ? <img class={`logo${LOGOS[b.model].invert ? " invert" : ""}`} src={LOGOS[b.model].src} alt={b.model} width="20" height="20" />
                : <span class="dot"></span>}
              <b>{b.model}</b>
              <span class="bet-pick">{pickLabel(b)}</span>
              <span class="bet-stake">${b.stake.toLocaleString()} @ {b.odds}</span>
              <span>{badge(b.status)}</span>
            </summary>
            <p class="reasoning">{b.reasoning}</p>
          </details>
        ))}
      </div>
    ))}
    {settled.length === 0 && <p class="failures">Nothing settled yet — first results land tonight.</p>}
    {todayFailures.length > 0 && (
      <p class="failures">⚠ {todayFailures.map((f) => f.model).join(", ")} couldn't produce a valid bet on the last run.</p>
    )}
  </section>

  <footer>
    Virtual money only — not financial advice. Same prompt for every model, published with
    the code and every bet's history: <a href="https://github.com/benjammartin/llm-worldcup-bets">github.com/benjammartin/llm-worldcup-bets</a>.
    Odds: median across ~25 bookmakers (the-odds-api). Results: football-data.org, settled on the 90-minute score.
  </footer>
</body>
</html>
