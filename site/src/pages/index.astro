---
import { readFileSync, existsSync } from "node:fs";
import { fileURLToPath } from "node:url";
import { chartSVG } from "../../../pipeline/src/chart";
import { BASELINE_NAME, MODELS, SITE_URL, STARTING_BANKROLL } from "../../../pipeline/src/config";
import { initialState, bankroll, type Bet, type State } from "../../../pipeline/src/state";
import { flagOf } from "../flags";

const statePath = fileURLToPath(new URL("../../../data/state.json", import.meta.url));
const state: State = existsSync(statePath)
  ? JSON.parse(readFileSync(statePath, "utf8"))
  : initialState([...MODELS.map((m) => m.name), BASELINE_NAME], STARTING_BANKROLL, new Date().toISOString());
const svg = chartSVG(state, 1200, 630);
const svgMobile = chartSVG(state, 760, 540, { compact: true });

const LOGOS: Record<string, { src: string; invert?: boolean }> = {
  "Claude": { src: "/logos/claude.svg" },
  "GPT-5": { src: "/logos/gpt-5.svg", invert: true },
  "Gemini": { src: "/logos/gemini.svg" },
  "Grok": { src: "/logos/grok.svg", invert: true },
  "DeepSeek": { src: "/logos/deepseek.svg" },
  "Mistral": { src: "/logos/mistral.svg" },
};
const COLORS: Record<string, string> = Object.fromEntries([
  ...MODELS.map((m) => [m.name, m.color]),
  [BASELINE_NAME, "#6b7280"],
]);

const money = (n: number) => `$${Math.round(n).toLocaleString("en-US")}`;
const standings = Object.keys(state.series)
  .sort((a, b) => bankroll(state, b) - bankroll(state, a))
  .map((name) => ({ name, roll: bankroll(state, name), delta: bankroll(state, name) - STARTING_BANKROLL }));
const maxAbsDelta = Math.max(100, ...standings.map((s) => Math.abs(s.delta)));
const leader = standings[0];

const pending = state.bets.filter((b) => b.status === "pending")
  .sort((a, b) => a.kickoff.localeCompare(b.kickoff));
const settled = state.bets.filter((b) => b.status !== "pending")
  .sort((a, b) => b.kickoff.localeCompare(a.kickoff)).slice(0, 60);

const byMatch = (bets: Bet[]) => {
  const m = new Map<string, Bet[]>();
  for (const b of bets) m.set(b.matchId, [...(m.get(b.matchId) ?? []), b]);
  return [...m.values()];
};
const badge = (s: string) => s === "won" ? "✅" : s === "lost" ? "❌" : s === "void" ? "↩︎" : "⏳";
const pickLabel = (b: Bet) =>
  b.pick === "draw" ? "🤝 Draw"
  : b.pick === "home" ? `${flagOf(b.homeTeam)} ${b.homeTeam}`
  : `${flagOf(b.awayTeam)} ${b.awayTeam}`;
const kickoff = (iso: string) =>
  new Date(iso).toLocaleString("en-GB", { weekday: "short", day: "numeric", month: "short", hour: "2-digit", minute: "2-digit", timeZone: "UTC" }) + " UTC";
const lastUpdate = state.meta.lastSettleRun ?? state.meta.lastBetsRun;
const todayFailures = state.meta.failures.slice(-6);
const matchday = Math.max(1, Math.floor((Date.now() - Date.parse("2026-06-11T00:00:00Z")) / 86_400_000) + 1);

const shareText = encodeURIComponent(
  `6 AIs are betting $10,000 each on every World Cup match, against real odds. Current leader: ${leader.name} (${money(leader.roll)}).`
);
const shareUrl = `https://twitter.com/intent/tweet?text=${shareText}&url=${encodeURIComponent(SITE_URL)}`;
const POSTHOG_KEY = import.meta.env.PUBLIC_POSTHOG_KEY ?? "";
const POSTHOG_HOST = import.meta.env.PUBLIC_POSTHOG_HOST ?? "https://wc.llmworldcup.xyz";
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>LLM World Cup Bets — 6 AIs, $10,000 each</title>
  <meta name="description" content="6 AIs bet virtual money on every World Cup 2026 match against real bookmaker odds. Live bankrolls, verbatim reasoning, public prompt." />
  <meta property="og:title" content="LLM World Cup Bets" />
  <meta property="og:description" content="6 AIs, $10,000 each, betting on every match of the World Cup. Who goes broke first?" />
  <meta property="og:image" content={`${SITE_URL}/og.png`} />
  <meta name="twitter:card" content="summary_large_image" />
  <style>
    @font-face { font-family: "Space Mono"; src: url("/fonts/SpaceMono-Regular.ttf") format("truetype"); font-weight: 400; font-display: swap; }
    @font-face { font-family: "Space Mono"; src: url("/fonts/SpaceMono-Bold.ttf") format("truetype"); font-weight: 700; font-display: swap; }

    :root {
      --bg: #050607; --panel: #0d0f12; --panel-2: #12151a; --line: #1c2128;
      --txt: #e7e9ea; --dim: #8b949e; --faint: #555e6a;
      --amber: #f59e0b; --up: #22c55e; --down: #ef4444;
    }
    * { box-sizing: border-box; }
    html { background: var(--bg); }
    body { background: var(--bg); color: var(--txt); font-family: "Space Mono", ui-monospace, monospace;
      margin: 0 auto; max-width: 1100px; padding: 0 14px; font-size: 14px; line-height: 1.5;
      font-variant-numeric: tabular-nums; }
    /* scanlines — the terminal texture */
    body::after { content: ""; position: fixed; inset: 0; pointer-events: none; z-index: 9;
      background: repeating-linear-gradient(0deg, transparent 0 2px, rgba(255,255,255,.012) 2px 3px); }

    /* ── ticker bar ───────────────────────────── */
    .ticker { display: flex; align-items: center; gap: 18px; flex-wrap: wrap;
      border-bottom: 1px solid var(--line); padding: 10px 2px; font-size: 12px;
      text-transform: uppercase; letter-spacing: .08em; color: var(--dim); }
    .live { color: var(--up); font-weight: 700; display: inline-flex; align-items: center; gap: 6px; }
    .live::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: var(--up);
      animation: pulse 1.6s ease-in-out infinite; }
    @keyframes pulse { 50% { opacity: .15; } }
    @media (prefers-reduced-motion: reduce) { .live::before { animation: none; } }
    .ticker .lead b { color: var(--amber); }

    header { padding: 28px 0 6px; }
    h1 { font-size: clamp(26px, 6vw, 44px); line-height: 1.05; letter-spacing: -.01em; margin: 0; }
    h1 .accent { color: var(--amber); }
    .tagline { color: var(--dim); max-width: 760px; margin: 12px 0 14px; font-size: clamp(13px, 2.6vw, 14px); }
    .tagline b { color: var(--txt); }
    .specs { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 8px; }
    .specs span { border: 1px solid var(--line); color: var(--dim); border-radius: 4px;
      font-size: 11px; text-transform: uppercase; letter-spacing: .06em; padding: 4px 8px; }
    .specs span b { color: var(--amber); font-weight: 700; }

    h2 { color: var(--txt); font-size: 13px; text-transform: uppercase; letter-spacing: .14em;
      margin: 40px 0 12px; display: flex; align-items: center; gap: 10px; }
    h2::before { content: ""; width: 5px; height: 16px; background: var(--amber); }
    h2::after { content: ""; flex: 1; height: 1px; background: var(--line); }
    h2 .count { color: var(--faint); letter-spacing: 0; }

    /* ── standings: market book ───────────────── */
    .standings { display: flex; flex-direction: column; gap: 5px; }
    .standing { display: grid; grid-template-columns: 30px 24px minmax(72px, auto) 1fr auto auto;
      align-items: center; gap: 10px; background: var(--panel); border: 1px solid var(--line);
      border-radius: 6px; padding: 9px 12px; position: relative; }
    .standing.first { border-color: color-mix(in srgb, var(--amber) 45%, var(--line)); background: linear-gradient(90deg, rgba(245,158,11,.06), var(--panel) 40%); }
    .standing .rank { color: var(--faint); font-size: 12px; }
    .standing.first .rank { color: var(--amber); font-weight: 700; }
    .standing .name { font-weight: 700; }
    .pl-track { height: 6px; border-radius: 3px; background: var(--panel-2); position: relative; overflow: hidden; min-width: 60px; }
    .pl-bar { position: absolute; top: 0; bottom: 0; border-radius: 3px; }
    .standing .delta { font-size: 12px; text-align: right; min-width: 84px; }
    .standing .roll { font-weight: 700; font-size: 15px; text-align: right; min-width: 84px; }
    .up { color: var(--up); } .down { color: var(--down); } .flat { color: var(--faint); }
    .logo { width: 20px; height: 20px; display: block; }
    .logo.invert { filter: invert(1); }
    .dot { width: 12px; height: 12px; border-radius: 50%; background: var(--c); margin: 4px; }
    .baseline-note { color: var(--faint); font-size: 12px; margin: 10px 2px 0; }
    .baseline-note b { color: var(--dim); }

    .share { display: flex; gap: 8px; margin-top: 14px; flex-wrap: wrap; }
    .share a, .share button { background: transparent; border: 1px solid var(--line); color: var(--dim);
      border-radius: 4px; padding: 8px 14px; font: inherit; font-size: 12px; text-transform: uppercase;
      letter-spacing: .08em; cursor: pointer; text-decoration: none; }
    .share a:hover, .share button:hover { border-color: var(--amber); color: var(--amber); }

    .chart { overflow: hidden; }
    :global(.chart svg) { display: block; width: 100%; max-width: 100%; height: auto; border: 1px solid var(--line); border-radius: 6px; }
    .chart-mobile { display: none; }
    @media (max-width: 700px) { .chart-desktop { display: none; } .chart-mobile { display: block; } }

    /* ── match cards ──────────────────────────── */
    .match { background: var(--panel); border: 1px solid var(--line); border-radius: 6px; margin-bottom: 12px; overflow: hidden; }
    .match-head { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; flex-wrap: wrap;
      padding: 11px 14px; border-bottom: 1px solid var(--line); background: var(--panel-2); }
    .match-title { font-weight: 700; font-size: 15px; }
    .match-title .vs { color: var(--faint); font-weight: 400; font-size: 12px; padding: 0 2px; }
    .match-ko { color: var(--faint); font-size: 11px; text-transform: uppercase; letter-spacing: .08em; }
    details { border-top: 1px solid #14171c; }
    details:first-of-type { border-top: none; }
    summary { cursor: pointer; list-style: none; display: grid; grid-template-columns: 24px 92px 1fr auto auto 24px;
      align-items: center; gap: 8px; padding: 9px 14px; font-size: 13px; }
    summary::-webkit-details-marker { display: none; }
    summary:hover { background: var(--panel-2); }
    details[open] summary { background: var(--panel-2); }
    .bet-pick { color: var(--dim); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .bet-stake { color: var(--txt); text-align: right; white-space: nowrap; }
    .bet-odds { color: var(--amber); font-size: 12px; white-space: nowrap; }
    .reasoning { color: var(--dim); font-size: 13px; line-height: 1.6; padding: 10px 14px 14px 26px; margin: 0;
      white-space: pre-wrap; position: relative; }
    .reasoning::before { content: "›"; position: absolute; left: 14px; color: var(--c); font-weight: 700; }
    .failures { color: var(--faint); font-size: 13px; }

    footer { margin: 56px 0 0; border-top: 1px solid var(--line); color: var(--faint); font-size: 12px;
      line-height: 1.7; padding: 16px 2px 28px; }
    footer .source-link { color: var(--faint); opacity: .55; font-size: 11px; }
    footer .source-link:hover { color: var(--dim); opacity: 1; }
    a { color: var(--amber); text-decoration: none; }
    a:hover { text-decoration: underline; }

    @media (max-width: 560px) {
      .standing { grid-template-columns: 22px 22px 1fr auto; }
      .pl-track, .standing .delta { display: none; }
      summary { grid-template-columns: 22px 80px 1fr 22px; }
      .bet-stake, .bet-odds { grid-column: 2 / 4; grid-row: 2; text-align: left; font-size: 12px; }
      .bet-odds { grid-column: 3 / 4; text-align: right; }
    }
  </style>
  {POSTHOG_KEY && (
    <script is:inline define:vars={{ POSTHOG_KEY, POSTHOG_HOST }}>
      !function(t,e){var o,n,p,r;e.__SV||(window.posthog && window.posthog.__loaded)||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.crossOrigin="anonymous",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="Xi tn init mn Qr yn xn pn capture calculateEventProperties Tn register register_once register_for_session unregister unregister_for_session Pn getFeatureFlag getFeatureFlagPayload getFeatureFlagResult isFeatureEnabled reloadFeatureFlags updateFlags updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures on onFeatureFlags onSurveysLoaded onSessionId getSurveys getActiveMatchingSurveys renderSurvey displaySurvey cancelPendingSurvey canRenderSurvey canRenderSurveyAsync On identify setPersonProperties group resetGroups setPersonPropertiesForFlags resetPersonPropertiesForFlags setGroupPropertiesForFlags resetGroupPropertiesForFlags reset setIdentity clearIdentity get_distinct_id getGroups get_session_id get_session_replay_url alias set_config startSessionRecording stopSessionRecording sessionRecordingStarted captureException addExceptionStep captureLog startExceptionAutocapture stopExceptionAutocapture loadToolbar get_property getSessionProperty Mn Cn createPersonProfile setInternalOrTestUser Rn vn Fn opt_in_capturing opt_out_capturing has_opted_in_capturing has_opted_out_capturing get_explicit_consent_status is_capturing clear_opt_in_out_capturing kn debug Kr En getPageViewId captureTraceFeedback captureTraceMetric hn".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
      posthog.init(POSTHOG_KEY, {
        api_host: POSTHOG_HOST,
        ui_host: "https://us.posthog.com",
        defaults: "2026-05-30",
        person_profiles: "identified_only",
      });
      document.addEventListener("click", function (e) {
        var share = e.target.closest && e.target.closest(".share a");
        if (share) posthog.capture("share_x_clicked");
      });
      document.addEventListener("toggle", function (e) {
        var d = e.target;
        if (d.tagName === "DETAILS" && d.open) {
          var model = d.querySelector("summary b");
          posthog.capture("reasoning_opened", { model: model ? model.textContent : "?" });
        }
      }, true);
    </script>
  )}
</head>
<body>
  <div class="ticker">
    <span class="live">Live</span>
    <span>Matchday {matchday}/39</span>
    <span>{pending.length} pending bets</span>
    <span class="lead">Leader: <b>{leader.name} {money(leader.roll)}</b></span>
  </div>

  <header>
    <h1>LLM WORLD CUP<br/><span class="accent">BETS</span> ⚽</h1>
    <p class="tagline">6 AIs entered the World Cup with <b>$10,000</b> each. Every day, every match, they bet against real bookmaker odds — and their reasoning is published <b>verbatim</b>. Highest bankroll on July 19 wins.</p>
    <div class="specs">
      <span><b>$10K</b> start</span>
      <span><b>25%</b> max stake</span>
      <span><b>~25</b> bookmakers</span>
      <span><b>104</b> matches</span>
      <span>settled on <b>90'</b></span>
    </div>
  </header>

  <section>
    <h2>Standings <span class="count">{lastUpdate && `· updated ${kickoff(lastUpdate)}`}</span></h2>
    <div class="standings">
      {standings.map((s, i) => (
        <div class={`standing${i === 0 ? " first" : ""}`} style={`--c:${COLORS[s.name] ?? "#fff"}`}>
          <span class="rank">{String(i + 1).padStart(2, "0")}</span>
          {LOGOS[s.name]
            ? <img class={`logo${LOGOS[s.name].invert ? " invert" : ""}`} src={LOGOS[s.name].src} alt={s.name} width="20" height="20" />
            : <span class="dot" title="Always bets the favorite"></span>}
          <span class="name">{s.name}</span>
          <span class="pl-track">
            {s.delta !== 0 && <span class="pl-bar" style={`background:${s.delta > 0 ? "var(--up)" : "var(--down)"};
              left:${s.delta > 0 ? "50%" : `${50 - (Math.abs(s.delta) / maxAbsDelta) * 50}%`};
              width:${(Math.abs(s.delta) / maxAbsDelta) * 50}%`}></span>}
            <span class="pl-bar" style="left:50%;width:1px;background:var(--line)"></span>
          </span>
          <span class={`delta ${s.delta > 0 ? "up" : s.delta < 0 ? "down" : "flat"}`}>
            {s.delta === 0 ? "±$0" : (s.delta > 0 ? "+$" : "−$") + Math.round(Math.abs(s.delta)).toLocaleString("en-US")}
          </span>
          <span class="roll">{money(s.roll)}</span>
        </div>
      ))}
    </div>
    <p class="baseline-note">— <b>Baseline</b> bets 10% on the favorite, every match. Any AI below it is officially dumber than an if-statement.</p>
    <div class="share">
      <a href={shareUrl} target="_blank" rel="noopener">𝕏 Share standings</a>
      <button onclick="navigator.clipboard.writeText(location.href).then(()=>{this.textContent='Copied ✓';setTimeout(()=>this.textContent='Copy link',1500)})">Copy link</button>
    </div>
  </section>

  <section>
    <h2>Bankroll over time</h2>
    <div class="chart chart-desktop" set:html={svg} />
    <div class="chart chart-mobile" set:html={svgMobile} />
  </section>

  <section>
    <h2>Pending bets <span class="count">· {pending.length}</span></h2>
    {byMatch(pending).map((bets) => (
      <div class="match">
        <div class="match-head">
          <span class="match-title">{flagOf(bets[0].homeTeam)} {bets[0].homeTeam} <span class="vs">vs</span> {bets[0].awayTeam} {flagOf(bets[0].awayTeam)}</span>
          <span class="match-ko">kicks off {kickoff(bets[0].kickoff)}</span>
        </div>
        {bets.map((b) => (
          <details style={`--c:${COLORS[b.model] ?? "#fff"}`}>
            <summary>
              {LOGOS[b.model]
                ? <img class={`logo${LOGOS[b.model].invert ? " invert" : ""}`} src={LOGOS[b.model].src} alt={b.model} width="20" height="20" />
                : <span class="dot"></span>}
              <b>{b.model}</b>
              <span class="bet-pick">{pickLabel(b)}</span>
              <span class="bet-stake">${b.stake.toLocaleString()}</span>
              <span class="bet-odds">@ {b.odds}</span>
              <span>{badge(b.status)}</span>
            </summary>
            <p class="reasoning">{b.reasoning}</p>
          </details>
        ))}
      </div>
    ))}
    {pending.length === 0 && <p class="failures">No pending bets — next bets land at 09:00 UTC.</p>}
  </section>

  <section>
    <h2>Recent results</h2>
    {byMatch(settled).map((bets) => (
      <div class="match">
        <div class="match-head">
          <span class="match-title">{flagOf(bets[0].homeTeam)} {bets[0].homeTeam} <span class="vs">vs</span> {bets[0].awayTeam} {flagOf(bets[0].awayTeam)}</span>
          <span class="match-ko">{kickoff(bets[0].kickoff)}</span>
        </div>
        {bets.map((b) => (
          <details style={`--c:${COLORS[b.model] ?? "#fff"}`}>
            <summary>
              {LOGOS[b.model]
                ? <img class={`logo${LOGOS[b.model].invert ? " invert" : ""}`} src={LOGOS[b.model].src} alt={b.model} width="20" height="20" />
                : <span class="dot"></span>}
              <b>{b.model}</b>
              <span class="bet-pick">{pickLabel(b)}</span>
              <span class="bet-stake">${b.stake.toLocaleString()}</span>
              <span class="bet-odds">@ {b.odds}</span>
              <span>{badge(b.status)}</span>
            </summary>
            <p class="reasoning">{b.reasoning}</p>
          </details>
        ))}
      </div>
    ))}
    {settled.length === 0 && <p class="failures">Nothing settled yet — first results land tonight.</p>}
    {todayFailures.length > 0 && (
      <p class="failures">⚠ {todayFailures.map((f) => f.model).join(", ")} couldn't produce a valid bet on the last run.</p>
    )}
  </section>

  <footer>
    Virtual money only — not financial advice. Same prompt for every model. Odds: median across ~25 bookmakers
    (the-odds-api). Results: football-data.org, settled on the 90-minute score.<br/>
    <a class="source-link" href="https://github.com/benjammartin/llm-worldcup-bets">Source / full bet history</a>
  </footer>
</body>
</html>
