---
import { readFileSync, existsSync } from "node:fs";
import { fileURLToPath } from "node:url";
import { chartSVG } from "../../../pipeline/src/chart";
import { BASELINE_NAME, MODELS, SITE_URL, STARTING_BANKROLL } from "../../../pipeline/src/config";

import { initialState, bankroll, type Bet, type State } from "../../../pipeline/src/state";
import { flagOf } from "../flags";

const statePath = fileURLToPath(new URL("../../../data/state.json", import.meta.url));
const state: State = existsSync(statePath)
  ? JSON.parse(readFileSync(statePath, "utf8"))
  : initialState([...MODELS.map((m) => m.name), BASELINE_NAME], STARTING_BANKROLL, new Date().toISOString());
const svg = chartSVG(state, 1200, 630);
const svgMobile = chartSVG(state, 760, 540, { compact: true });

const LOGOS: Record<string, { src: string; invert?: boolean }> = {
  "Claude": { src: "/logos/claude.svg" },
  "GPT-5.5": { src: "/logos/gpt-5.svg", invert: true },
  "Gemini": { src: "/logos/gemini.svg" },
  "Grok": { src: "/logos/grok.svg", invert: true },
  "DeepSeek": { src: "/logos/deepseek.svg" },
  "Mistral": { src: "/logos/mistral.svg" },
};
const COLORS: Record<string, string> = Object.fromEntries([
  ...MODELS.map((m) => [m.name, m.color]),
  [BASELINE_NAME, "#6b7280"],
]);
const MODEL_DETAILS: Record<string, string> = Object.fromEntries([
  ...MODELS.map((m) => [m.name, m.id.replace(/^[^/]+\//, "")]),
  [BASELINE_NAME, "10% favorite rule"],
]);

const money = (n: number) => `$${Math.round(n).toLocaleString("en-US")}`;
const standings = Object.keys(state.series)
  .sort((a, b) => bankroll(state, b) - bankroll(state, a))
  .map((name) => ({ name, roll: bankroll(state, name), delta: bankroll(state, name) - STARTING_BANKROLL }));
const maxAbsDelta = Math.max(100, ...standings.map((s) => Math.abs(s.delta)));
const leader = standings[0];
const pending = state.bets.filter((b) => b.status === "pending")
  .sort((a, b) => a.kickoff.localeCompare(b.kickoff));
const settled = state.bets.filter((b) => b.status !== "pending")
  .sort((a, b) => b.kickoff.localeCompare(a.kickoff));

const modelCycleStats = Object.fromEntries(standings.map((s) => {
  const bets = pending.filter((b) => b.model === s.name);
  const exposure = bets.reduce((sum, b) => sum + b.stake, 0);
  const avgOdds = bets.length ? bets.reduce((sum, b) => sum + b.odds, 0) / bets.length : 0;
  return [s.name, { bets: bets.length, exposure, avgOdds }];
}));

const byMatch = (bets: Bet[]) => {
  const m = new Map<string, Bet[]>();
  for (const b of bets) m.set(b.matchId, [...(m.get(b.matchId) ?? []), b]);
  return [...m.values()];
};
const pendingMatches = byMatch(pending);
const settledMatches = byMatch(settled);
const upcomingMatches = (state.meta.upcomingMatches ?? [])
  .filter((m) => Date.parse(m.kickoff) > Date.now())
  .sort((a, b) => a.kickoff.localeCompare(b.kickoff));
const visibleMatchCount = pending.length > 0 ? pendingMatches.length : upcomingMatches.length;
const badge = (s: string) => s === "won" ? "✅" : s === "lost" ? "❌" : s === "void" ? "↩︎" : "⏳";
const pickLabel = (b: Bet) =>
  b.pick === "draw" ? "🤝 Draw"
  : b.pick === "home" ? `${flagOf(b.homeTeam)} ${b.homeTeam}`
  : `${flagOf(b.awayTeam)} ${b.awayTeam}`;
const pickText = (pick: Bet["pick"], b: Bet) =>
  pick === "draw" ? "Draw" : pick === "home" ? b.homeTeam : b.awayTeam;
const matchInsight = (bets: Bet[]) => {
  const counts = { home: 0, draw: 0, away: 0 } as Record<Bet["pick"], number>;
  for (const b of bets) counts[b.pick] += 1;
  const entries = (Object.entries(counts) as [Bet["pick"], number][])
    .filter(([, count]) => count > 0)
    .sort((a, b) => b[1] - a[1]);
  const top = entries[0];
  const split = entries.map(([pick, count]) => `${count} ${pickText(pick, bets[0])}`).join(" / ");
  const biggest = [...bets].sort((a, b) => b.stake - a.stake)[0];
  const verdict = top[1] === bets.length
    ? `Consensus: ${top[1]}/${bets.length} pick ${pickText(top[0], bets[0])}`
    : `Split: ${split}`;
  return `${verdict} · biggest stake: ${biggest.model} ${money(biggest.stake)}`;
};
const totalPendingExposure = pending.reduce((sum, b) => sum + b.stake, 0);
const resultOrder: Record<Bet["status"], number> = { won: 0, lost: 1, void: 2, pending: 3 };
const settledBetRows = (bets: Bet[]) =>
  [...bets].sort((a, b) => resultOrder[a.status] - resultOrder[b.status] || b.stake - a.stake || a.model.localeCompare(b.model));
const betPnl = (b: Bet) => b.status === "won" ? b.stake * (b.odds - 1) : b.status === "lost" ? -b.stake : 0;
const pnlText = (b: Bet) => {
  const pnl = betPnl(b);
  if (pnl === 0) return "$0";
  return `${pnl > 0 ? "+" : "−"}$${Math.round(Math.abs(pnl)).toLocaleString("en-US")}`;
};
const resultLabel = (b: Bet) => b.status === "won" ? "Won" : b.status === "lost" ? "Lost" : b.status === "void" ? "Void" : "Pending";
const settledOutcomeLabel = (bets: Bet[]) => {
  const result = bets.find((b) => b.settledResult)?.settledResult;
  const score = bets.find((b) => b.settledScore)?.settledScore;
  if (result && result !== "void") return `${pickText(result, bets[0])}${score ? ` wins ${score}` : " wins"}`;
  if (result === "void") return score ? `Result voided ${score}` : "Result voided";
  const winners = bets.filter((b) => b.status === "won");
  if (winners.length > 0) return `${pickText(winners[0].pick, winners[0])} wins`;
  const losingPicks = [...new Set(bets.filter((b) => b.status === "lost").map((b) => b.pick))];
  if (losingPicks.length === 1) return `not ${pickText(losingPicks[0], bets[0])}`;
  return "the winning result";
};
const settledInsight = (bets: Bet[]) => {
  const outcome = settledOutcomeLabel(bets);
  const winners = bets.filter((b) => b.status === "won");
  const losses = bets.filter((b) => b.status === "lost");
  const voids = bets.filter((b) => b.status === "void");
  if (winners.length > 0) {
    const biggestWin = [...winners].sort((a, b) => betPnl(b) - betPnl(a))[0];
    return `Result: ${outcome} · ${winners.length}/${bets.length} models cashed · biggest win: ${biggestWin.model} ${pnlText(biggestWin)} · ${losses.length} lost`;
  }
  if (voids.length === bets.length) return `${outcome} · all ${bets.length} stakes returned`;
  return `Result: ${outcome} · no model cashed · all ${losses.length} settled bets lost`;
};
const kickoff = (iso: string) =>
  new Date(iso).toLocaleString("en-GB", { weekday: "short", day: "numeric", month: "short", hour: "2-digit", minute: "2-digit", timeZone: "UTC" }) + " UTC";
const lastUpdate = state.meta.lastSettleRun ?? state.meta.lastBetsRun;
const OG_IMAGE_LAYOUT_VERSION = "data-card-v1";
const ogImageVersion = encodeURIComponent(`${lastUpdate ?? "initial"}-${OG_IMAGE_LAYOUT_VERSION}`);
const todayFailures = state.meta.failures.slice(-6);
const matchday = Math.max(1, Math.floor((Date.now() - Date.parse("2026-06-11T00:00:00Z")) / 86_400_000) + 1);
const topExposure = Object.entries(modelCycleStats)
  .filter(([, stats]) => stats.bets > 0)
  .sort((a, b) => b[1].exposure - a[1].exposure)[0];
const biggestSwing = [...pending].sort((a, b) => b.odds - a.odds)[0];
const cycleSummary = pending.length === 0
  ? "No live bets right now — upcoming matches are listed below; AI bets open 50 minutes before kickoff."
  : `${pendingMatches.length} matches currently open · ${pending.length} live bets${topExposure ? ` · most exposed: ${topExposure[0]} ${money(topExposure[1].exposure)}` : ""}${biggestSwing ? ` · biggest swing: ${biggestSwing.model} on ${pickText(biggestSwing.pick, biggestSwing)} @ ${biggestSwing.odds}` : ""}.`;
const mobileCycleSummary = pending.length === 0
  ? "Bets open 50 min before kickoff."
  : `${pendingMatches.length} matches · ${pending.length} pending bets.`;
const canonicalUrl = `${SITE_URL}/`;
const ogImageUrl = `${SITE_URL}/og.png?v=${ogImageVersion}`;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "LLM World Cup Bets",
  url: canonicalUrl,
  description: "We gave 6 AIs $10,000 each to bet on the World Cup. Watch the AI gambling reality show: live bankrolls, stupid bets, shame board, verbatim reasoning.",
  image: ogImageUrl,
  inLanguage: "en",
  isAccessibleForFree: true,
  about: ["World Cup 2026", "AI gambling reality show", "AI predictions", "sports betting simulation"],
};
const youtubeLiveUrl = "https://youtube.com/live/FYYYwyMgcKU?feature=share";
const POSTHOG_KEY = import.meta.env.PUBLIC_POSTHOG_KEY ?? "";
const POSTHOG_HOST = import.meta.env.PUBLIC_POSTHOG_HOST ?? "https://wc.llmworldcup.xyz";
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>6 AIs. $10,000 each. One World Cup.</title>
  <meta name="description" content="We gave 6 AIs $10,000 each to bet on the World Cup. Watch them bet, panic, and go broke: live bankrolls, stupid bets, shame board, and verbatim reasoning." />
  <meta name="robots" content="index,follow,max-image-preview:large" />
  <link rel="canonical" href={canonicalUrl} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:site_name" content="LLM World Cup Bets" />
  <meta property="og:title" content="6 AIs. $10,000 each. One World Cup." />
  <meta property="og:description" content="Watch the AI gambling reality show: live World Cup bets, bankrolls, model picks, and verbatim reasoning." />
  <meta property="og:image" content={ogImageUrl} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="6 AIs. $10,000 each. One World Cup." />
  <meta name="twitter:description" content="Watch them bet, panic, and go broke. AI World Cup gambling reality show." />
  <meta name="twitter:image" content={ogImageUrl} />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <style>
    @font-face { font-family: "Space Mono"; src: url("/fonts/SpaceMono-Regular.ttf") format("truetype"); font-weight: 400; font-display: swap; }
    @font-face { font-family: "Space Mono"; src: url("/fonts/SpaceMono-Bold.ttf") format("truetype"); font-weight: 700; font-display: swap; }

    :root {
      --bg: #050607; --panel: #0d0f12; --panel-2: #12151a; --line: #1c2128;
      --txt: #e7e9ea; --dim: #8b949e; --faint: #555e6a;
      --amber: #f59e0b; --up: #22c55e; --down: #ef4444;
    }
    * { box-sizing: border-box; }
    html { background: var(--bg); }
    body { background: var(--bg); color: var(--txt); font-family: "Space Mono", ui-monospace, monospace;
      margin: 0 auto; max-width: 1100px; padding: 0 14px; font-size: 14px; line-height: 1.5;
      font-variant-numeric: tabular-nums; }
    /* scanlines — the terminal texture */
    body::after { content: ""; position: fixed; inset: 0; pointer-events: none; z-index: 9;
      background: repeating-linear-gradient(0deg, transparent 0 2px, rgba(255,255,255,.012) 2px 3px); }

    /* ── ticker bar ───────────────────────────── */
    .ticker { display: flex; align-items: center; gap: 18px; flex-wrap: wrap;
      border-bottom: 1px solid var(--line); padding: 10px 2px; font-size: 12px;
      text-transform: uppercase; letter-spacing: .08em; color: var(--dim); }
    .live { color: var(--up); font-weight: 700; display: inline-flex; align-items: center; gap: 6px; }
    .live::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: var(--up);
      animation: pulse 1.6s ease-in-out infinite; }
    @keyframes pulse { 50% { opacity: .15; } }
    @media (prefers-reduced-motion: reduce) { .live::before { animation: none; } }
    .ticker .lead b { color: var(--amber); }
    .youtube-marquee { display: block; overflow: hidden; border: 1px solid color-mix(in srgb, #ff0033 42%, var(--line));
      border-radius: 999px; margin: 12px 0 0; background: linear-gradient(90deg, rgba(255,0,51,.14), rgba(245,158,11,.08));
      color: var(--txt); text-decoration: none; white-space: nowrap; }
    .youtube-marquee:hover { text-decoration: none; border-color: #ff0033; }
    .youtube-track { display: inline-flex; gap: 32px; min-width: max-content; padding: 8px 0;
      animation: youtube-scroll 18s linear infinite; }
    .youtube-track span { display: inline-flex; align-items: center; gap: 10px; padding-right: 32px;
      font-size: 12px; text-transform: uppercase; letter-spacing: .09em; }
    .youtube-badge { color: #fff; background: #ff0033; border-radius: 999px; padding: 2px 8px; font-weight: 700; }
    .youtube-cta { color: var(--amber); font-weight: 700; }
    @keyframes youtube-scroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }
    @media (prefers-reduced-motion: reduce) { .youtube-track { animation: none; } }

    header { padding: 28px 0 6px; }
    .hero { padding: 34px 0 12px; }
    .hero h1 { font-size: clamp(34px, 8.4vw, 76px); line-height: .94; letter-spacing: -.055em; margin: 0; max-width: 980px; }
    .hero h1 .accent { color: var(--amber); }
    .hero-sub { color: var(--txt); max-width: 820px; margin: 16px 0 12px; font-size: clamp(17px, 3vw, 25px); line-height: 1.25; }
    .hero-sub b { color: var(--amber); }
    .hero-proof { color: var(--dim); max-width: 760px; margin: 0 0 18px; font-size: 13px; }
    .hero-cta { display: inline-flex; align-items: center; border: 1px solid var(--amber); background: var(--amber); color: #050607;
      border-radius: 999px; padding: 11px 16px; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; font-size: 12px; }
    .hero-cta:hover { text-decoration: none; filter: brightness(1.06); }
    h1 { font-size: clamp(26px, 6vw, 44px); line-height: 1.05; letter-spacing: -.01em; margin: 0; }
    h1 .accent { color: var(--amber); }
    .tagline { color: var(--dim); max-width: 760px; margin: 12px 0 14px; font-size: clamp(13px, 2.6vw, 14px); }
    .tagline b { color: var(--txt); }
    .cycle-note { color: var(--faint); max-width: 760px; margin: 0 0 8px; font-size: 12px; }
    .cycle-note b { color: var(--amber); }

    h2 { color: var(--txt); font-size: 13px; text-transform: uppercase; letter-spacing: .14em;
      margin: 40px 0 12px; display: flex; align-items: center; gap: 10px; }
    h2::before { content: ""; width: 5px; height: 16px; background: var(--amber); }
    h2::after { content: ""; flex: 1; height: 1px; background: var(--line); }
    h2 .count { color: var(--faint); letter-spacing: 0; }

    /* ── standings: market book ───────────────── */
    .standings { display: flex; flex-direction: column; gap: 5px; }
    .standing { display: grid; grid-template-columns: 30px 24px minmax(110px, auto) minmax(70px, 1fr) auto auto auto;
      align-items: center; gap: 10px; background: var(--panel); border: 1px solid var(--line);
      border-radius: 6px; padding: 9px 12px; position: relative; }
    .standing.first { border-color: color-mix(in srgb, var(--amber) 45%, var(--line)); background: linear-gradient(90deg, rgba(245,158,11,.06), var(--panel) 40%); }
    .standing .rank { color: var(--faint); font-size: 12px; }
    .standing.first .rank { color: var(--amber); font-weight: 700; }
    .standing .name { font-weight: 700; display: flex; flex-direction: column; line-height: 1.15; }
    .model-id { color: var(--faint); font-size: 10px; font-weight: 400; letter-spacing: 0; text-transform: none; }
    .cycle-risk { color: var(--faint); font-size: 11px; white-space: nowrap; text-align: right; }
    .pl-track { height: 6px; border-radius: 3px; background: var(--panel-2); position: relative; overflow: hidden; min-width: 60px; }
    .pl-bar { position: absolute; top: 0; bottom: 0; border-radius: 3px; }
    .standing .delta { font-size: 12px; text-align: right; min-width: 84px; }
    .standing .roll { font-weight: 700; font-size: 15px; text-align: right; min-width: 84px; }
    .up { color: var(--up); } .down { color: var(--down); } .flat { color: var(--faint); }
    .logo { width: 20px; height: 20px; display: block; }
    .logo.invert { filter: invert(1); }
    .dot { width: 12px; height: 12px; border-radius: 50%; background: var(--c); margin: 4px; }
    .chart { overflow: hidden; }
    :global(.chart svg) { display: block; width: 100%; max-width: 100%; height: auto; border: 1px solid var(--line); border-radius: 6px; }
    .chart-mobile { display: none; }
    @media (max-width: 700px) { .chart-desktop { display: none; } .chart-mobile { display: block; } }

    /* ── match cards ──────────────────────────── */
    .match { background: var(--panel); border: 1px solid var(--line); border-radius: 6px; margin-bottom: 12px; overflow: hidden; }
    .match-head { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; flex-wrap: wrap;
      padding: 11px 14px; border-bottom: 1px solid var(--line); background: var(--panel-2); }
    .match-title { font-weight: 700; font-size: 15px; }
    .match-title .vs { color: var(--faint); font-weight: 400; font-size: 12px; padding: 0 2px; }
    .match-meta { display: inline-flex; align-items: center; gap: 10px; flex-wrap: wrap; justify-content: flex-end; }
    .bet-count { color: var(--amber); font-size: 11px; text-transform: uppercase; letter-spacing: .08em; }
    .match-ko { color: var(--faint); font-size: 11px; text-transform: uppercase; letter-spacing: .08em; }
    .cycle-summary { color: var(--dim); background: var(--panel); border: 1px solid var(--line); border-radius: 6px;
      padding: 10px 12px; margin: -4px 0 12px; font-size: 13px; }
    .match-insight { color: var(--faint); border-bottom: 1px solid #14171c; padding: 8px 14px; font-size: 12px; }
    .upcoming-card { background: var(--panel); border: 1px solid var(--line); border-radius: 6px; margin-bottom: 8px; padding: 11px 14px;
      display: flex; justify-content: space-between; gap: 12px; align-items: baseline; flex-wrap: wrap; }
    .upcoming-card .match-title { font-size: 14px; }
    .upcoming-status { color: var(--amber); font-size: 11px; text-transform: uppercase; letter-spacing: .08em; }

    details { border-top: 1px solid #14171c; }
    details:first-of-type { border-top: none; }
    summary { cursor: pointer; list-style: none; display: grid; grid-template-columns: 24px 142px minmax(180px, 1fr) minmax(84px, auto) 54px 72px;
      align-items: center; gap: 12px; padding: 9px 14px; font-size: 13px; }
    summary::-webkit-details-marker { display: none; }
    summary:hover { background: var(--panel-2); }
    details[open] summary { background: var(--panel-2); }
    summary .name { display: flex; flex-direction: column; min-width: 0; line-height: 1.15; }
    summary .model-id { display: block; overflow-wrap: anywhere; }
    .bet-pick { color: var(--dim); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .bet-stake { color: var(--txt); text-align: right; white-space: nowrap; }
    .bet-odds { color: var(--amber); font-size: 12px; white-space: nowrap; }
    .result-summary { grid-template-columns: 24px 142px minmax(150px, 1fr) minmax(78px, auto) 54px minmax(74px, auto) 72px; }
    .result-insight { color: var(--txt); border-bottom: 1px solid #14171c; padding: 9px 14px; font-size: 12px; }
    .result-legend { color: var(--dim); background: var(--panel); border: 1px solid var(--line); border-radius: 6px;
      padding: 10px 12px; margin: -4px 0 12px; font-size: 13px; }
    .result-pill { border: 1px solid var(--line); border-radius: 999px; padding: 3px 8px; font-size: 11px;
      text-align: center; text-transform: uppercase; letter-spacing: .06em; white-space: nowrap; }
    .result-pill.won { color: var(--up); border-color: color-mix(in srgb, var(--up) 45%, var(--line)); background: rgba(34,197,94,.08); }
    .result-pill.lost { color: var(--down); border-color: color-mix(in srgb, var(--down) 45%, var(--line)); background: rgba(239,68,68,.08); }
    .result-pill.void { color: var(--faint); }
    .result-pnl { font-weight: 700; text-align: right; white-space: nowrap; }
    .result-row.won summary { background: linear-gradient(90deg, rgba(34,197,94,.055), transparent 58%); }
    .result-row.lost summary { opacity: .78; }
    .reason-toggle { color: var(--amber); border: 1px solid color-mix(in srgb, var(--amber) 35%, var(--line));
      border-radius: 999px; padding: 3px 8px; font-size: 11px; text-transform: uppercase; letter-spacing: .06em;
      white-space: nowrap; justify-self: end; }
    .reason-toggle::after { content: " ↓"; }
    details[open] .reason-toggle::after { content: " ↑"; }
    .reasoning { color: var(--dim); font-size: 13px; line-height: 1.6; padding: 10px 14px 14px 26px; margin: 0;
      white-space: pre-wrap; position: relative; }
    .reasoning::before { content: "›"; position: absolute; left: 14px; color: var(--c); font-weight: 700; }
    .failures { color: var(--faint); font-size: 13px; }
    .mobile-only { display: none; }

    footer { margin: 56px 0 0; border-top: 1px solid var(--line); color: var(--faint); font-size: 12px;
      line-height: 1.7; padding: 16px 2px 28px; }
    footer .source-link { color: var(--faint); opacity: .55; font-size: 11px; }
    footer .source-link:hover { color: var(--dim); opacity: 1; }
    a { color: var(--amber); text-decoration: none; }
    a:hover { text-decoration: underline; }

    @media (max-width: 560px) {
      body { padding: 0 10px; font-size: 13px; }
      header { padding-top: 18px; }
      .hero { padding-top: 22px; }
      .hero h1 { font-size: clamp(38px, 13vw, 58px); }
      .hero-sub { font-size: 17px; }
      .ticker { gap: 10px; font-size: 10px; }
      .youtube-marquee { margin-top: 10px; border-radius: 10px; }
      .youtube-track { animation-duration: 14s; }
      .youtube-track span { font-size: 10px; gap: 7px; }
      .ticker .lead { display: none; }
      h2 { margin-top: 26px; font-size: 12px; gap: 7px; }
      h2 .count { display: none; }
      .standing { grid-template-columns: 22px 22px 1fr auto; }
      .pl-track, .standing .delta, .cycle-risk { display: none; }
      .standing .model-id { display: none; }
      .desktop-only { display: none; }
      .mobile-only { display: inline; }
      .cycle-summary, .match-insight, .result-legend, .result-insight { font-size: 11px; padding: 8px 10px; }

      .match-head { padding: 10px; }
      .match-meta { width: 100%; justify-content: flex-start; gap: 8px; }
      summary { grid-template-columns: 22px minmax(64px, 1fr) minmax(68px, 1fr) auto auto; padding: 8px 10px; gap: 6px; }
      .result-summary { grid-template-columns: 22px minmax(74px, 1fr) minmax(54px, .75fr) auto minmax(52px, auto) auto; }
      summary .model-id { display: none; }
      .bet-pick { font-size: 12px; }
      .bet-odds { display: none; }
      .result-pill { font-size: 10px; padding: 2px 6px; }
      .result-pnl { font-size: 12px; }
      .bet-stake { text-align: right; font-size: 12px; }
      .reason-toggle { padding: 3px 7px; font-size: 10px; }
      .result-summary .reason-toggle { grid-column: 6; justify-self: end; }
      .reasoning { padding-left: 22px; font-size: 12px; }
    }
  </style>
  {POSTHOG_KEY && (
    <script is:inline define:vars={{ POSTHOG_KEY, POSTHOG_HOST }}>
      !function(t,e){var o,n,p,r;e.__SV||(window.posthog && window.posthog.__loaded)||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.crossOrigin="anonymous",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="Xi tn init mn Qr yn xn pn capture calculateEventProperties Tn register register_once register_for_session unregister unregister_for_session Pn getFeatureFlag getFeatureFlagPayload getFeatureFlagResult isFeatureEnabled reloadFeatureFlags updateFlags updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures on onFeatureFlags onSurveysLoaded onSessionId getSurveys getActiveMatchingSurveys renderSurvey displaySurvey cancelPendingSurvey canRenderSurvey canRenderSurveyAsync On identify setPersonProperties group resetGroups setPersonPropertiesForFlags resetPersonPropertiesForFlags setGroupPropertiesForFlags resetGroupPropertiesForFlags reset setIdentity clearIdentity get_distinct_id getGroups get_session_id get_session_replay_url alias set_config startSessionRecording stopSessionRecording sessionRecordingStarted captureException addExceptionStep captureLog startExceptionAutocapture stopExceptionAutocapture loadToolbar get_property getSessionProperty Mn Cn createPersonProfile setInternalOrTestUser Rn vn Fn opt_in_capturing opt_out_capturing has_opted_in_capturing has_opted_out_capturing get_explicit_consent_status is_capturing clear_opt_in_out_capturing kn debug Kr En getPageViewId captureTraceFeedback captureTraceMetric hn".split(" "