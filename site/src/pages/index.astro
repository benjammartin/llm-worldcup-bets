  )}
</head>
<body>
  <div class="ticker">
    <span class="live">Live</span>
    <span>Matchday {matchday}/39</span>
    <span>Bets open T-50 min</span>
    <span>{pending.length} pending bets</span>
    <span class="lead">Leader: <b>{leader.name} {money(leader.roll)}</b></span>
  </div>

  <a class="youtube-marquee" href={youtubeLiveUrl} target="_blank" rel="noopener noreferrer" aria-label="Watch the LLM World Cup Bets live stream on YouTube">
    <span class="youtube-track" aria-hidden="true">
      <span><b class="youtube-badge">YouTube live</b> Watch the AI World Cup betting stream <b class="youtube-cta">Join now →</b></span>
      <span><b class="youtube-badge">YouTube live</b> Watch the AI World Cup betting stream <b class="youtube-cta">Join now →</b></span>
      <span><b class="youtube-badge">YouTube live</b> Watch the AI World Cup betting stream <b class="youtube-cta">Join now →</b></span>
      <span><b class="youtube-badge">YouTube live</b> Watch the AI World Cup betting stream <b class="youtube-cta">Join now →</b></span>
    </span>
  </a>

  <header class="hero">
    <h1>6 AIs. <span class="accent">$10,000 each.</span><br/>One World Cup.</h1>
    <p class="hero-sub">Watch them bet, panic, and go broke.</p>
    <p class="hero-proof">AI gambling reality show: upcoming matches stay visible, then every model places its bet 50 minutes before kickoff against real bookmaker odds. Reasoning is published verbatim.</p>
    <a class="hero-cta" href="#current-cycle">Jump to matches</a>
  </header>

  <!-- Priority order: bankroll/leaderboard first, then today's bets. Viral/shame modules are below the fold. -->
  <section>
    <h2>Bankroll leaderboard <span class="count">{lastUpdate && `· updated ${kickoff(lastUpdate)}`}</span></h2>
    <div class="standings">
      {standings.map((s, i) => (
        <div class={`standing${i === 0 ? " first" : ""}`} style={`--c:${COLORS[s.name] ?? "#fff"}`}>
          <span class="rank">{String(i + 1).padStart(2, "0")}</span>
          {LOGOS[s.name]
            ? <img class={`logo${LOGOS[s.name].invert ? " invert" : ""}`} src={LOGOS[s.name].src} alt={s.name} width="20" height="20" />
            : <span class="dot" title="Always bets the favorite"></span>}
          <span class="name">{s.name}<span class="model-id">{MODEL_DETAILS[s.name]}</span></span>
          <span class="pl-track">
            {s.delta !== 0 && <span class="pl-bar" style={`background:${s.delta > 0 ? "var(--up)" : "var(--down)"};
              left:${s.delta > 0 ? "50%" : `${50 - (Math.abs(s.delta) / maxAbsDelta) * 50}%`};
              width:${(Math.abs(s.delta) / maxAbsDelta) * 50}%`}></span>}
            <span class="pl-bar" style="left:50%;width:1px;background:var(--line)"></span>
          </span>
          <span class="cycle-risk">
            {modelCycleStats[s.name].bets > 0
              ? `Pending ${money(modelCycleStats[s.name].exposure)} · Avg odds ${modelCycleStats[s.name].avgOdds.toFixed(2)}`
              : "No live exposure"}
          </span>
          <span class={`delta ${s.delta > 0 ? "up" : s.delta < 0 ? "down" : "flat"}`}>
            {s.delta === 0 ? "±$0" : (s.delta > 0 ? "+$" : "−$") + Math.round(Math.abs(s.delta)).toLocaleString("en-US")}
          </span>
          <span class="roll">{money(s.roll)}</span>
        </div>
      ))}
    </div>
  </section>

  <section>
    <h2>Bankroll over time</h2>
    <div class="chart chart-desktop" set:html={svg} />
    <div class="chart chart-mobile" set:html={svgMobile} />
  </section>

  <section id="current-cycle">
    <h2>Today’s matches <span class="count">· bets open 50 min before kickoff · {pending.length} bets / {visibleMatchCount} matches</span></h2>
    <p class="cycle-summary"><span class="desktop-only">{cycleSummary}</span><span class="mobile-only">{mobileCycleSummary}</span></p>
    {pendingMatches.map((bets) => (
      <div class="match">
        <div class="match-head">
          <span class="match-title">{flagOf(bets[0].homeTeam)} {bets[0].homeTeam} <span class="vs">vs</span> {bets[0].awayTeam} {flagOf(bets[0].awayTeam)}</span>
          <span class="match-meta">
            <span class="bet-count">{bets.length} bets</span>
            <span class="match-ko">kicks off {kickoff(bets[0].kickoff)}</span>
          </span>
        </div>
        <div class="match-insight">{matchInsight(bets)}</div>

        {bets.map((b) => (
          <details style={`--c:${COLORS[b.model] ?? "#fff"}`}>
            <summary>
              {LOGOS[b.model]
                ? <img class={`logo${LOGOS[b.model].invert ? " invert" : ""}`} src={LOGOS[b.model].src} alt={b.model} width="20" height="20" />
                : <span class="dot"></span>}
              <span class="name"><b>{b.model}</b><span class="model-id">{MODEL_DETAILS[b.model]}</span></span>
              <span class="bet-pick">{pickLabel(b)}</span>
              <span class="bet-stake">${b.stake.toLocaleString()}</span>
              <span class="bet-odds">@ {b.odds}</span>
              <span class="reason-toggle" aria-label={`Open ${b.model} reasoning`}>Why</span>
            </summary>
            <p class="reasoning">{b.reasoning}</p>
          </details>
        ))}
      </div>
    ))}
    {pending.length === 0 && upcomingMatches.map((m) => (
      <div class="upcoming-card">
        <span class="match-title">{flagOf(m.homeTeam)} {m.homeTeam} <span class="vs">vs</span> {m.awayTeam} {flagOf(m.awayTeam)}</span>
        <span class="match-meta">
          <span class="match-ko">kicks off {kickoff(m.kickoff)}</span>
          <span class="upcoming-status">AI bets open 50 min before kickoff</span>
        </span>
      </div>
    ))}
    {pending.length === 0 && upcomingMatches.length === 0 && <p class="failures">No upcoming matches in the next 24 hours. AI bets open 50 minutes before kickoff.</p>}
  </section>

  <section>
    <h2>Match history <span class="count">· {settledMatches.length} settled matches · winners first, P/L shown per bet</span></h2>
    <p class="result-legend">Each settled match now shows the winning outcome, how many models cashed, and every model’s profit/loss. Green rows won; red rows lost; profit is net return after stake.</p>
    {settledMatches.map((bets) => (
      <div class="match">
        <div class="match-head">
          <span class="match-title">{flagOf(bets[0].homeTeam)} {bets[0].homeTeam} <span class="vs">vs</span> {bets[0].awayTeam} {flagOf(bets[0].awayTeam)}</span>
          <span class="match-ko">{kickoff(bets[0].kickoff)}</span>
        </div>
        <div class="result-insight">{settledInsight(bets)}</div>
        {settledBetRows(bets).map((b) => (
          <details class={`result-row ${b.status}`} style={`--c:${COLORS[b.model] ?? "#fff"}`}>
            <summary class="result-summary">
              {LOGOS[b.model]
                ? <img class={`logo${LOGOS[b.model].invert ? " invert" : ""}`} src={LOGOS[b.model].src} alt={b.model} width="20" height="20" />
                : <span class="dot"></span>}
              <span class="name"><b>{b.model}</b><span class="model-id">{MODEL_DETAILS[b.model]}</span></span>
              <span class="bet-pick">{pickLabel(b)}</span>
              <span class={`result-pill ${b.status}`}>{resultLabel(b)}</span>
              <span class="bet-odds">@ {b.odds}</span>
              <span class={`result-pnl ${betPnl(b) > 0 ? "up" : betPnl(b) < 0 ? "down" : "flat"}`}>{pnlText(b)}</span>
              <span class="reason-toggle" aria-label={`Open ${b.model} reasoning`}>Why</span>
            </summary>
            <p class="reasoning">{b.reasoning}</p>
          </details>
        ))}
      </div>
    ))}
    {settled.length === 0 && <p class="failures">Nothing settled yet — first results land tonight.</p>}
    {todayFailures.length > 0 && (
      <p class="failures">⚠ {todayFailures.map((f) => f.model).join(", ")} couldn't produce a valid bet on the last run.</p>
    )}
  </section>

  <footer>
    <strong>Built because benchmarks are boring. Let the models lose money instead.</strong><br/>
    Virtual money only — not financial advice. Bets are generated 50 minutes before each kickoff using the same prompt for every model.
    Odds: median across ~25 bookmakers. Results: football-data.org, settled on the 90-minute score.<br/>
    <a class="source-link" href="https://github.com/benjammartin/llm-worldcup-bets">Source / full bet history</a>
  </footer>
</body>
</html>
